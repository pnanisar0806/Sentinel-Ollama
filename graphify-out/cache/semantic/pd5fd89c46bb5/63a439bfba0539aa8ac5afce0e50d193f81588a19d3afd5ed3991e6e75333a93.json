{"nodes": [{"id": "index_repo_map", "label": "index.md repo map", "file_type": "document", "source_file": "index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Read at session start in place of the ~4,700-line plan; lists every module's exports and role so the agent never has to re-read the plan end to end."}, {"id": "index_architecture_test_no_catch_up", "label": "no-catch-up architecture test", "file_type": "concept", "source_file": "index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A real checker, not a stub: it walks src/**/*.ts off disk, builds the import graph and asserts the transitive reachers of funded-status.ts are exactly buckets.ts, notify/digest.ts and jobs/digest.ts. Adding a fourth reader must be a deliberate allowlist edit."}, {"id": "index_rails_tactical_budget_defect", "label": "Known defect: TACTICAL_BUDGET_EXCEEDED fires permanently", "file_type": "concept", "source_file": "index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "checkPortfolioRails compares the whole equity book's market value against the Rs 50k/month tactical flow budget \u2014 a stock-versus-flow comparison \u2014 so the rail is always in violation."}, {"id": "index_rails_hardcoded_vs_table", "label": "Rails hard-coded despite PRD 11 saying they live in settings_rails", "file_type": "rationale", "source_file": "index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only cash_ceiling_pct is actually read from settings_rails; every other rail is a hard-coded literal or a CAPS constant, and RAIL_CONSTRAINTS is exported and imported by nobody."}, {"id": "index_derive_the_actual_side", "label": "Derive the actual side of an assertion from real data", "file_type": "rationale", "source_file": "index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A guard-rail test that hard-codes both sides tests nothing \u2014 this is how the plan's false claim that the seed breaches the Sammaan cap survived. Never hard-code a literal downstream of seed data; it goes stale silently. The deliberate exception is surplus.test.ts, whose literals fail loudly on purpose."}, {"id": "index_workflow_schedule_table", "label": "Workflow schedule table", "file_type": "document", "source_file": "index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The single place the cron times, triggers and reasons for ci / sync / digest / weekly / keepalive / screener-reminder are recorded together."}], "edges": [{"source": "_github_workflows_screener_reminder_screener_reminder", "target": "readme_fr_31_staleness", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "index.md", "source_location": null, "weight": 1.0}, {"source": "index_workflow_schedule_table", "target": "docs_setup_digest_workflow", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "index.md", "source_location": null, "weight": 1.0}, {"source": "index_architecture_test_no_catch_up", "target": "readme_funded_status_firewall", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "index.md", "source_location": null, "weight": 1.0}, {"source": "index_derive_the_actual_side", "target": "index_architecture_test_no_catch_up", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "index.md", "source_location": null, "weight": 1.0}, {"source": "index_rails_hardcoded_vs_table", "target": "index_rails_tactical_budget_defect", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "sou