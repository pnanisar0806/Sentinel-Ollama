{"nodes": [{"id": "docs_superpowers_plans_2026_09_16_sentinel_phase_2_plan", "label": "Sentinel Phase 2 Implementation Plan", "file_type": "document", "source_file": "docs/superpowers/plans/2026-09-16-sentinel-phase-2.md", "source_location": null, "source_url": null, "captured_at": "2026-09-17", "author": null, "contributor": null, "rationale": "Corrected against the PRD; explicitly refuses to introduce broker placement, execution bridge, real fills or a live advisory loop, and forbids resurrecting Kite OAuth as 'Phase 2 preparation'."}, {"id": "docs_superpowers_plans_2026_09_16_sentinel_phase_2_db_interface", "label": "Db Four-Method Interface", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-16-sentinel-phase-2.md", "source_location": "Existing contracts and scope", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "query/exec/withTransaction/close is the shipped interface, not the obsolete two-method plan sketch; withTransaction pins one connection and does not nest, and ::jsonb params take objects because postgres-js otherwise stores opaque JSON strings."}, {"id": "docs_superpowers_plans_2026_09_16_sentinel_phase_2_immutable_history", "label": "Immutable History vs Current State", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-09-16-sentinel-phase-2.md", "source_location": "Persistence section", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Immutable order intent/revision records plus append-only transition events, with current status derived through a reader/view \u2014 because putting an append-only trigger on a row and then UPDATE-ing its status is a contradiction. Modifications append a revision and invalidate the prior approval."}, {"id": "docs_superpowers_plans_2026_09_16_sentinel_phase_2_task1_paper_orders", "label": "Task 1: Paper Orders + Approval State Machine", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-16-sentinel-phase-2.md", "source_location": "Task 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Execution-side states are paper simulator events only; the simulator cannot be selected as a live execution adapter."}, {"id": "docs_superpowers_plans_2026_09_16_sentinel_phase_2_task2_rails", "label": "Task 2: Rails, Freeze, Breaker, Behavioral Protocol", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-16-sentinel-phase-2.md", "source_location": "Task 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Breaker counts distinct approved recommendations' falsification outcomes, not duplicate events or individual legs, so replayed or duplicate observations cannot fabricate a streak."}, {"id": "docs_superpowers_plans_2026_09_16_sentinel_phase_2_task3_cleanup", "label": "Task 3: Paper Cleanup + Multi-Year LTCG Calendar", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-16-sentinel-phase-2.md", "source_location": "Task 3 (complete)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shipped as src/domain/cleanup.ts + src/jobs/cleanup.ts with 14 tests. Existing aggregate owner-cost lots are not reliable acquisition lots; missing history yields unknown estimates and named owner-data prerequisites, never \u20b90 tax or a fabricated exemption."}, {"id": "docs_superpowers_plans_2026_09_16_sentinel_phase_2_task4_web", "label": "Task 4: Web Approval/Cleanup/Rail Surfaces", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-16-sentinel-phase-2.md", "source_location": "Task 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Extends the existing standalone Next.js app rather than relocating to web/src/app; no OHLC charts when only close data exists, and single-owner auth is required before remote deployment."}, {"id": "docs_superpowers_plans_2026_09_16_sentinel_phase_2_task5_scheduling", "label": "Task 5: Paper Scheduling, Scoring, Backup/Restore", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-16-sentinel-phase-2.md", "source_location": "Task 5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Expiry is enforced at every action/read boundary rather than trusting cron delivery; a runbook without a tested restore into an isolated database does not satisfy Phase 2."}, {"id": "docs_superpowers_plans_2026_09_16_sentinel_phase_2_task6_acceptance", "label": "Task 6: Provisioning, Handoff, Phase 2 Acceptance", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-16-sentinel-phase-2.md", "source_location": "Task 6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tests cannot replace four elapsed weeks or five owner interactions; evidence must be dated, and an inherited test count is not proof."}, {"id": "docs_superpowers_plans_2026_09_16_sentinel_phase_2_paper_simulator", "label": "Paper Execution Simulator", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-16-sentinel-phase-2.md", "source_location": "Task 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Simulates session-missing, partial fill, verbatim broker rejection and market closure without any broker dependency or real holdings/lots/cash writes."}, {"id": "docs_superpowers_plans_2026_09_16_sentinel_phase_2_orders_module", "label": "src/domain/orders.ts (planned)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-16-sentinel-phase-2.md", "source_location": "Task 1 files", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_09_16_sentinel_phase_2_rails_module", "label": "src/domain/rails.ts (planned)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-16-sentinel-phase-2.md", "source_location": "Task 2 files", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_09_16_sentinel_phase_2_cleanup_module", "label": "src/domain/cleanup.ts", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-16-sentinel-phase-2.md", "source_location": "Task 3 implemented", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_09_16_sentinel_phase_2_funded_status_firewall", "label": "funded_status Architecture Test", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-16-sentinel-phase-2.md", "source_location": "Existing contracts and scope", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "funded_status must not reach drafting, sizing, rails, risk or recommendation logic, including through reporting helpers or payload injection."}, {"id": "docs_superpowers_plans_2026_09_16_sentinel_phase_2_expiry_policy", "label": "Approval Expiry Policy (EOD / 7 days)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-16-sentinel-phase-2.md", "source_location": "FR-22 row", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Market approvals expire at end of trading day via the NSE session calendar; SIP/MF changes after 7 days. There is no universal 72-hour expiry, and limit-order lifetime is an explicit open owner decision rather than an invented default."}, {"id": "docs_superpowers_plans_2026_09_16_sentinel_phase_2_backup_restore", "label": "Encrypted pg_dump Backup + Tested Restore", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-16-sentinel-phase-2.md", "source_location": "Task 5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Restore must be verified in an isolated database covering rows, constraints and immutable history; no production overwrite."}], "edges": [{"source": "docs_superpowers_plans_2026_09_16_sentinel_phase_2_plan", "target": "prd_investment_agent_phase_2_prove", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-09-16-sentinel-phase-2.md", "source_location": "Header + Task 6", "weight": 1.0}, {"source": "docs_superpowers_plans_2026_09_16_sentinel_phase_2_plan", "target": "prd_investment_agent_ips", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-09-16-sentinel-phase-2.md", "source_location": "\"corrected against PRD \u00a7\u00a73.9\u20133.10, 5.3\u20135.4, 7, 11\u201314\"", "weight": 1.0}, {"source": "docs_superpowers_plans_2026_09_16_sentinel_phase_2_task1_paper_orders", "target": "prd_investment_agent_approval_state_machine", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-09-16-sentinel-phase-2.md", "source_location": "Task 1 state contract from PRD \u00a77.1", "weight": 1.0}, {"source": "docs_superpowers_plans_2026_09_16_sentinel_phase_2_task1_paper_orders", "target": "docs_superpowers_plans_2026_09_16_sentinel_phase_2_paper_simulator", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-09-16-sentinel-phase-2.md", "source_location": "Task 1", "weight": 1.0}, {"source": "docs_superpowers_plans_2026_09_16_sentinel_phase_2_task1_paper_orders", "target": "docs_superpowers_plans_2026_09_16_sentinel_phase_2_orders_module", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-09-16-sentinel-phase-2.md", "source_location": "Task 1 files", "weight": 1.0}, {"source": "docs_superpowers_plans_2026_09_16_sentinel_phase_2_task1_paper_orders", "target": "docs_superpowers_plans_2026_09_16_sentinel_phase_2_immutable_history", "rel