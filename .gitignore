node_modules/
dist/
.env
.pglite/
*.local.json
run-claude.ps1

# The owner's real holdings. .env.example names this exact path as the default
# snapshot, so dropping a live export here would otherwise stage the whole portfolio
# for commit. The .example file beside it is the one that is tracked.
data/indmoney-snapshot.json
data/*.snapshot.json
# Pre-deletion dumps of real holdings (e.g. the retired kite snapshot).
data/*backup*.json

data/screenshots/

# Local agent tooling state / scratch files — never tracked.
.claude/
.serena/
*.mp4

# Local preview web app (Next.js) — build artefacts and deps.
web/node_modules/
web/.next/
web/tsconfig.tsbuildinfo

# Dev-server capture from `pnpm web`; local only.
.next-dev-out.log
.next-dev-err.log
