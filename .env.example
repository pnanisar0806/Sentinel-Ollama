# Leave DATABASE_URL unset to use embedded PGlite locally.
# Supabase: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# 32 random bytes, base64. Encrypts the INDmoney refresh token at rest.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# LLM statement extraction (web upload + Telegram) via OpenRouter free vision models.
# Key must live in this file (not only the current shell) or the Next server started
# from another terminal runs with extraction dormant. Leave LLM_MODEL unset to walk the
# free vision-model chain.
LLM_API_KEY=
LLM_MODEL=

# Manual fallback only; the OAuth source is preferred once you have run indmoney:login
INDMONEY_SNAPSHOT_PATH=data/indmoney-snapshot.json

# 1 = compose the digest but do not send it
DRY_RUN=
# Weekly deep report (FR-51, `pnpm report`).
# Narration model for PRD 6.7; unset falls back to the default OpenRouter model. The
# narrative is optional — without LLM_API_KEY the report ships its deterministic bullets.
WEEKLY_LLM_MODEL=
# 10Y G-sec yield, percent, e.g. 6.9. The valuation leg of the signal engine scores
# earnings yield against it. There is NO ingestion source for this — it is the owner's
# number. Blank means "not configured": the report says the signal review did not run
# rather than scoring against an invented 0%.
GSEC_YIELD_PCT=
# Screener.in CSV import is a manual, owner-driven step — `pnpm screener:import <path>` —
# so there is no path variable. The file never lives in the repo.
